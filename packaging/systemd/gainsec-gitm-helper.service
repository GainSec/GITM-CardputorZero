[Unit]
Description=GainSec GITM privileged network helper
Requires=gainsec-gitm-helper.socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/gainsec-gitm-helper serve
KillMode=control-group
User=root
Group=root
RuntimeDirectory=gainsec-gitm
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/gainsec-gitm /var/log/gainsec-gitm /proc/sys/net/ipv4/ip_forward
LogsDirectory=gainsec-gitm
LogsDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_KILL CAP_SETUID CAP_SETGID
